# Pruebas del paso de voz (T017 D5, D9, D12; respuestas/03-audio.md) con el
# motor de prueba (sin red ni clave). Las de OpenAI corren dentro del sandbox
# sin red (sin-red.sb): ninguna llamada puede salir del equipo.
# Variables: CASO, VOZ (satcfdi_video_voz), GRABADOR (satcfdi_video_tutorial),
# SIN_RED (lista), GUION, DIR.

set(clave_prueba "sk-prueba-NO-FILTRAR-7c1e9d2b")
file(REMOVE_RECURSE "${DIR}")
file(MAKE_DIRECTORY "${DIR}")
set(cache "${DIR}/cache")

# correr(<var_prefijo> [ENV k=v...] ARGS ...): ejecuta el paso de voz.
function(correr prefijo)
    cmake_parse_arguments(C "" "" "ENV;ARGS" ${ARGN})
    execute_process(
        COMMAND ${CMAKE_COMMAND} -E env ${C_ENV} ${VOZ} ${C_ARGS}
        RESULT_VARIABLE codigo
        OUTPUT_VARIABLE salida
        ERROR_VARIABLE errores)
    message("$ satcfdi_video_voz ${C_ARGS}\n${salida}${errores}")
    set(${prefijo}_codigo "${codigo}" PARENT_SCOPE)
    set(${prefijo}_salida "${salida}${errores}" PARENT_SCOPE)
endfunction()

function(exigir texto patron)
    if(NOT texto MATCHES "${patron}")
        message(FATAL_ERROR "no aparece \"${patron}\"")
    endif()
endfunction()

# Guion con lineas cambiadas (texto de pantalla y hablado).
function(guion_modificado salida n)
    file(READ "${GUION}" g)
    string(REPLACE "Esta es la lista de solicitudes de descarga masiva."
                   "Esta es la lista de solicitudes, version dos." g "${g}")
    if(NOT g MATCHES "version dos")
        message(FATAL_ERROR "no se pudo modificar el guion de prueba")
    endif()
    if(n GREATER 1)
        string(REPLACE "La búsqueda filtra por RFC, nombre, UUID o folio."
                       "La búsqueda filtra por RFC o nombre, version dos." g "${g}")
    endif()
    file(WRITE "${salida}" "${g}")
endfunction()

# Marca de una linea segun la salida "alineado <bloque>: ...; <linea>=X s".
function(marca salida linea var)
    string(REGEX MATCH "${linea}=([0-9.]+) s" _ "${salida}")
    set(${var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

function(total_cuadros guion var)
    execute_process(COMMAND ${GRABADOR} --guion ${guion} --validar --voz ${cache} --motor-voz prueba
                    RESULT_VARIABLE codigo OUTPUT_VARIABLE salida ERROR_VARIABLE errores)
    message("${salida}${errores}")
    if(NOT codigo EQUAL 0)
        message(FATAL_ERROR "--validar --voz fallo")
    endif()
    string(REGEX MATCH "lineas, ([0-9]+) cuadros" _ "${salida}")
    set(${var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

if(CASO STREQUAL "cache_completo")
    correr(a ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    if(NOT a_codigo EQUAL 0)
        message(FATAL_ERROR "la primera generacion fallo")
    endif()
    exigir("${a_salida}" "sintetizados: [1-9][0-9]*; montados: [1-9][0-9]*; alineados: [1-9][0-9]*; generacion g000001 publicada")
    correr(b ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    exigir("${b_salida}" "sintetizados: 0; montados: 0; alineados: 0 \\(cache completo, sin llamadas\\)")
    # --estimar no llama y no cambia nada.
    correr(c ARGS --guion ${GUION} --cache ${cache} --motor prueba --estimar)
    exigir("${c_salida}" "por sintetizar: 0 ")

elseif(CASO STREQUAL "alineacion_correcta")
    # Motor de prueba: 350 ms entre frases. Bloque menu-bar: la linea l1
    # (62 caracteres a 15/s) dura 4.13 s; la marca de l2 cae 50 ms antes de su
    # voz: 0.065 + 4.133 + 0.350 - 0.050 = 4.50 s.
    correr(a ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    marca("${a_salida}" "explorador/menu-bar/l2" m)
    if(m STREQUAL "" OR m LESS 4.45 OR m GREATER 4.55)
        message(FATAL_ERROR "marca de menu-bar/l2 = '${m}' s; se esperaba 4.50 +- 0.05")
    endif()
    total_cuadros(${GUION} t)

elseif(CASO STREQUAL "alineacion_falla")
    # Sin pausas entre frases la alineacion debe fallar nombrando escena y
    # bloque; el audio queda publicado (no se vuelve a pagar).
    correr(a ENV SATCFDI_VOZ_PRUEBA_SIN_PAUSAS=1 ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    if(a_codigo EQUAL 0)
        message(FATAL_ERROR "la alineacion sin pausas no fallo")
    endif()
    exigir("${a_salida}" "alineacion: escena 'explorador/menu-bar', bloque 'explorador/menu-bar': se esperaban 1 pausas entre frases \\(al menos 1 entre lineas\\) y se detectaron 0")
    exigir("${a_salida}" "generacion g000001 publicada")
    # La grabacion no puede usar el bloque sin alinear.
    execute_process(COMMAND ${GRABADOR} --guion ${GUION} --validar --voz ${cache} --motor-voz prueba
                    RESULT_VARIABLE codigo OUTPUT_VARIABLE salida ERROR_VARIABLE errores)
    exigir("${salida}${errores}" "bloque '[a-z/-]+': falta su audio de voz alineado")
    # Corregir a mano las marcas no llama a TTS.
    file(WRITE "${cache}/alineacion/correcciones.json"
         "{\"explorador/menu-bar/l2\": 4.5, \"explorador/facturas/l2\": 3.4, \"perfiles/registrar-efirma/l2\": 5.1}\n")
    correr(b ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    exigir("${b_salida}" "sintetizados: 0; montados: 0; alineados: 3;")
    total_cuadros(${GUION} t)

elseif(CASO STREQUAL "correccion_manual")
    correr(a ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    file(MAKE_DIRECTORY "${cache}/alineacion")
    file(WRITE "${cache}/alineacion/correcciones.json" "{\"explorador/menu-bar/l2\": 4.0}\n")
    correr(b ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    exigir("${b_salida}" "sintetizados: 0; montados: 0; alineados: 1;")
    marca("${b_salida}" "explorador/menu-bar/l2" m)
    if(NOT m STREQUAL "4.00")
        message(FATAL_ERROR "la correccion no se aplico (marca ${m})")
    endif()
    # Una correccion que deja un cue de menos de 1 s se rechaza.
    file(WRITE "${cache}/alineacion/correcciones.json" "{\"explorador/menu-bar/l2\": 0.5}\n")
    correr(c ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    if(c_codigo EQUAL 0)
        message(FATAL_ERROR "una correccion invalida no fallo")
    endif()
    exigir("${c_salida}" "escena 'explorador/menu-bar', bloque 'explorador/menu-bar': el cue de la linea 'explorador/menu-bar/l1' dura 0.50 s \\(minimo 1 s\\)")

elseif(CASO STREQUAL "cambio_pausas")
    correr(a ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    total_cuadros(${GUION} antes)
    file(READ "${GUION}" g)
    string(REPLACE "\"cuadrosTitulo\": 75,"
                   "\"cuadrosTitulo\": 75,\n  \"pausas\": {\"bloque\": 400, \"escena\": 800, \"capitulo\": 1200},"
                   g "${g}")
    file(WRITE "${DIR}/guion.json" "${g}")
    correr(b ARGS --guion ${DIR}/guion.json --cache ${cache} --motor prueba)
    exigir("${b_salida}" "sintetizados: 0; montados: 0; alineados: 0")
    total_cuadros(${DIR}/guion.json despues)
    if(despues EQUAL antes)
        message(FATAL_ERROR "cambiar las pausas no cambio la linea de tiempo (${antes} cuadros)")
    endif()
    message("OK: pausas sin TTS; ${antes} -> ${despues} cuadros")

elseif(CASO STREQUAL "cambio_tempo")
    # Tempo de montaje 1.1: sin sintesis; bloques ~1/1.1 mas cortos y la
    # alineacion sigue valida. Marca de menu-bar/l2 a 1.0: 4.50 s; a 1.1:
    # 0.065 + (4.133 + 0.350) / 1.1 - 0.050 = 4.09 s.
    correr(a ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    total_cuadros(${GUION} antes)
    file(READ "${GUION}" g)
    string(REPLACE "\"cuadrosTitulo\": 75," "\"cuadrosTitulo\": 75,\n  \"montaje\": {\"tempo\": 1.1}," g "${g}")
    file(WRITE "${DIR}/guion.json" "${g}")
    correr(b ARGS --guion ${DIR}/guion.json --cache ${cache} --motor prueba)
    if(NOT b_codigo EQUAL 0)
        message(FATAL_ERROR "el montaje con tempo 1.1 fallo")
    endif()
    exigir("${b_salida}" "tempo de montaje: 1.10")
    exigir("${b_salida}" "sintetizados: 0; montados: 10; alineados: 10;") # 10 bloques desde T024.4 (escena meses)
    marca("${b_salida}" "explorador/menu-bar/l2" m)
    if(m STREQUAL "" OR m LESS 4.04 OR m GREATER 4.14)
        message(FATAL_ERROR "marca de menu-bar/l2 con tempo 1.1 = '${m}' s; se esperaba 4.09 +- 0.05")
    endif()
    # Duracion de cada bloque montado ~ 1/1.1 de la original (manifiesto).
    file(READ "${cache}/actual.json" puntero)
    string(JSON gen GET "${puntero}" generacion)
    file(READ "${cache}/generaciones/${gen}/manifiesto.json" mf)
    string(JSON nm LENGTH "${mf}" montaje)
    math(EXPR ultimo "${nm} - 1")
    set(pares 0)
    foreach(i RANGE ${ultimo})
        string(JSON clave MEMBER "${mf}" montaje ${i})
        string(JSON tempo ERROR_VARIABLE sin_tempo GET "${mf}" montaje ${clave} tempo)
        if(sin_tempo OR NOT tempo GREATER 1.05)
            continue()
        endif()
        string(JSON sha GET "${mf}" montaje ${clave} sha256Audio)
        string(JSON corta GET "${mf}" montaje ${clave} muestras)
        foreach(k RANGE ${ultimo})
            string(JSON otra MEMBER "${mf}" montaje ${k})
            string(JSON t2 ERROR_VARIABLE e2 GET "${mf}" montaje ${otra} tempo)
            string(JSON sha2 GET "${mf}" montaje ${otra} sha256Audio)
            if(sha2 STREQUAL sha AND NOT e2 AND t2 LESS 1.05)
                string(JSON larga GET "${mf}" montaje ${otra} muestras)
                # La voz se acorta 1/1.1; los 215 ms de extremos no (10320 muestras).
                math(EXPR esperado "(${larga} - 10320) * 10 / 11 + 10320")
                math(EXPR dif "${corta} - ${esperado}")
                if(dif GREATER 2400 OR dif LESS -2400)
                    message(FATAL_ERROR "bloque ${sha}: ${corta} muestras con tempo 1.1; se esperaban ~${esperado}")
                endif()
                math(EXPR pares "${pares} + 1")
            endif()
        endforeach()
    endforeach()
    if(NOT pares EQUAL 10) # 10 bloques desde T024.4 (escena meses)
        message(FATAL_ERROR "se compararon ${pares} bloques (se esperaban 10)")
    endif()
    total_cuadros(${DIR}/guion.json despues)
    if(NOT despues LESS antes)
        message(FATAL_ERROR "con tempo 1.1 el video no se acorto (${antes} -> ${despues})")
    endif()
    message("OK tempo 1.1: sin TTS; ${pares} bloques ~1/1.1; ${antes} -> ${despues} cuadros")

elseif(CASO STREQUAL "pausa_maxima")
    # R1d: "montaje": {"pausaMaxima": 200} acorta a 200 ms los silencios
    # internos (el motor de prueba deja 350 ms entre frases) sin TTS; los
    # extremos no cambian, la alineacion sigue valida y cada marca se adelanta
    # 150 ms por cada pausa acortada antes de ella (la suya incluida).
    correr(a ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    marca("${a_salida}" "explorador/menu-bar/l2" m1)
    total_cuadros(${GUION} antes)
    file(READ "${GUION}" g)
    string(REPLACE "\"cuadrosTitulo\": 75," "\"cuadrosTitulo\": 75,\n  \"montaje\": {\"pausaMaxima\": 200}," g "${g}")
    file(WRITE "${DIR}/guion.json" "${g}")
    correr(b ARGS --guion ${DIR}/guion.json --cache ${cache} --motor prueba)
    if(NOT b_codigo EQUAL 0)
        message(FATAL_ERROR "el montaje con pausaMaxima 200 fallo")
    endif()
    exigir("${b_salida}" "pausa maxima: 200 ms")
    exigir("${b_salida}" "sintetizados: 0; montados: 10; alineados: 10;") # 10 bloques desde T024.4 (escena meses)
    exigir("${b_salida}" "alineado explorador/menu-bar \\[frases; pausas 1 de 1 esperadas; 1 acortadas\\]")
    marca("${b_salida}" "explorador/menu-bar/l2" m2)
    # La pausa se detecta sin comprimir y la marca pasa por el mapa:
    # 4.50 s (sin compresion) - 0.150 s = 4.35 s.
    if(NOT m1 STREQUAL "4.50" OR m2 STREQUAL "" OR m2 LESS 4.33 OR m2 GREATER 4.37)
        message(FATAL_ERROR "marca de menu-bar/l2 = '${m1}' -> '${m2}' s; se esperaba 4.50 -> 4.35 +- 0.02")
    endif()
    file(READ "${cache}/actual.json" puntero)
    string(JSON gen GET "${puntero}" generacion)
    file(READ "${cache}/generaciones/${gen}/manifiesto.json" mf)
    string(JSON nm LENGTH "${mf}" montaje)
    math(EXPR ultimo "${nm} - 1")
    set(acortados 0)
    foreach(i RANGE ${ultimo})
        string(JSON clave MEMBER "${mf}" montaje ${i})
        string(JSON pm ERROR_VARIABLE sin_pm GET "${mf}" montaje ${clave} pausaMaxima)
        if(sin_pm OR NOT pm EQUAL 200)
            continue()
        endif()
        string(JSON n GET "${mf}" montaje ${clave} pausasAcortadas)
        string(JSON corta GET "${mf}" montaje ${clave} muestras)
        string(JSON larga GET "${mf}" montaje ${clave} muestrasSinComprimir)
        # Cada pausa de ~350 ms queda en 200: ~150 ms (7200 muestras) menos.
        math(EXPR esperado "${larga} - ${n} * 7200")
        math(EXPR dif "${corta} - ${esperado}")
        if(dif GREATER 960 OR dif LESS -960)
            message(FATAL_ERROR "bloque ${clave}: ${corta} muestras con ${n} pausas acortadas; se esperaban ~${esperado}")
        endif()
        if(n GREATER 0)
            string(JSON pcm GET "${mf}" montaje ${clave} pcmAlineacion)
            if(NOT EXISTS "${cache}/generaciones/${gen}/${pcm}")
                message(FATAL_ERROR "falta el audio sin comprimir ${pcm}")
            endif()
            math(EXPR acortados "${acortados} + 1")
        endif()
    endforeach()
    if(acortados LESS 1)
        message(FATAL_ERROR "ningun bloque acorto pausas")
    endif()
    total_cuadros(${DIR}/guion.json despues)
    if(NOT despues LESS antes)
        message(FATAL_ERROR "con pausaMaxima el video no se acorto (${antes} -> ${despues})")
    endif()
    # Sin cambios: cache completo.
    correr(c ARGS --guion ${DIR}/guion.json --cache ${cache} --motor prueba)
    exigir("${c_salida}" "sintetizados: 0; montados: 0; alineados: 0")
    message("OK pausaMaxima 200: sin TTS; ${acortados} bloques acortados; ${antes} -> ${despues} cuadros")

elseif(CASO STREQUAL "varias_frases")
    # R1c: cues con 1 a 3 frases (incluye "¿...?", puntos suspensivos y ":"
    # seguido de mayuscula). El motor de prueba hace 350 ms de pausa entre
    # frases; la frontera de cada cue es la pausa que cierra su ultima frase.
    correr(a ARGS --guion ${GUION_FRASES} --cache ${cache} --motor prueba)
    if(NOT a_codigo EQUAL 0)
        message(FATAL_ERROR "la alineacion por frases fallo")
    endif()
    exigir("${a_salida}" "alineado c/frases \\[frases; pausas 7 de 7 esperadas; 0 acortadas\\]")
    foreach(par "l2;4.58" "l3;6.20" "l4;11.72")
        list(GET par 0 linea)
        list(GET par 1 esperada)
        marca("${a_salida}" "c/frases/${linea}" m)
        if(m STREQUAL "")
            message(FATAL_ERROR "sin marca para ${linea}")
        endif()
        string(REGEX REPLACE "^([0-9]+)\\.([0-9][0-9]).*" "\\1\\2" mc "${m}")
        string(REGEX REPLACE "^([0-9]+)\\.([0-9][0-9]).*" "\\1\\2" ec "${esperada}")
        math(EXPR dif "${mc} - ${ec}")
        if(dif GREATER 5 OR dif LESS -5)
            message(FATAL_ERROR "marca de ${linea} = ${m} s; se esperaba ${esperada} +- 0.05")
        endif()
    endforeach()
    message("OK varias frases: marcas en la pausa que cierra la ultima frase de cada cue")

elseif(CASO STREQUAL "cambio_linea")
    correr(a ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    guion_modificado("${DIR}/guion.json" 1)
    correr(b ARGS --guion ${DIR}/guion.json --cache ${cache} --motor prueba)
    exigir("${b_salida}" "por sintetizar: 1 ")
    exigir("${b_salida}" "sintetizados: 1; montados: 1; alineados: 1; generacion g000002 publicada")

elseif(CASO STREQUAL "fallo_lote")
    correr(a ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    file(SHA256 "${cache}/actual.json" puntero_antes)
    file(GLOB_RECURSE archivos_antes RELATIVE "${cache}" "${cache}/generaciones/*")
    guion_modificado("${DIR}/guion.json" 2)
    correr(b ENV SATCFDI_VOZ_PRUEBA_FALLAR_EN=2 ARGS --guion ${DIR}/guion.json --cache ${cache} --motor prueba)
    if(b_codigo EQUAL 0)
        message(FATAL_ERROR "el fallo simulado a mitad del lote no hizo fallar el paso de voz")
    endif()
    exigir("${b_salida}" "no se publico nada: el cache de voz queda como estaba")
    file(SHA256 "${cache}/actual.json" puntero_despues)
    file(GLOB_RECURSE archivos_despues RELATIVE "${cache}" "${cache}/generaciones/*")
    file(GLOB restos "${cache}/.preparando-*")
    if(NOT puntero_antes STREQUAL puntero_despues OR NOT archivos_antes STREQUAL archivos_despues OR restos)
        message(FATAL_ERROR "el cache cambio tras un fallo a mitad del lote")
    endif()
    # Sin el fallo, se sintetizan los dos bloques.
    correr(c ARGS --guion ${DIR}/guion.json --cache ${cache} --motor prueba)
    exigir("${c_salida}" "sintetizados: 2; montados: 2; alineados: 2; generacion g000002 publicada")

elseif(CASO STREQUAL "sin_clave")
    correr(a ENV --unset=OPENAI_API_KEY ARGS --guion ${GUION} --cache ${cache} --confirmar)
    if(a_codigo EQUAL 0)
        message(FATAL_ERROR "sin OPENAI_API_KEY el paso de voz no fallo")
    endif()
    exigir("${a_salida}" "falta OPENAI_API_KEY en el entorno \\(D9\\); no se hizo ninguna llamada")
    if(EXISTS "${cache}/actual.json")
        message(FATAL_ERROR "sin clave no debe publicarse nada")
    endif()

elseif(CASO STREQUAL "clave_no_filtrada")
    # OpenAI dentro del sandbox sin red: la conexion falla y la clave no debe
    # aparecer en la salida ni en ningun archivo.
    execute_process(
        COMMAND ${CMAKE_COMMAND} -E env OPENAI_API_KEY=${clave_prueba}
                ${SIN_RED} ${VOZ} --guion ${GUION} --cache ${cache} --confirmar --muestra lista
        RESULT_VARIABLE codigo OUTPUT_VARIABLE salida ERROR_VARIABLE errores)
    message("${salida}${errores}")
    if(codigo EQUAL 0)
        message(FATAL_ERROR "sin red la sintesis no puede tener exito")
    endif()
    exigir("${salida}${errores}" "bloque perfiles/lista: error de red")
    # Motor de prueba con la clave en el entorno: tampoco debe copiarla.
    correr(b ENV OPENAI_API_KEY=${clave_prueba} ARGS --guion ${GUION} --cache ${cache} --motor prueba)
    string(FIND "${salida}${errores}${b_salida}" "${clave_prueba}" pos)
    if(NOT pos EQUAL -1)
        message(FATAL_ERROR "la clave aparecio en la salida")
    endif()
    file(GLOB_RECURSE generados "${DIR}/*")
    foreach(f IN LISTS generados)
        file(STRINGS "${f}" coincidencias REGEX "${clave_prueba}")
        if(coincidencias)
            message(FATAL_ERROR "la clave aparecio en ${f}")
        endif()
    endforeach()
    message("OK: la clave no aparece en la salida ni en archivos generados")
else()
    message(FATAL_ERROR "CASO desconocido: ${CASO}")
endif()
