# T020 D5: el icono compilado versionado corresponde a sus fuentes.
#
#   cmake -DRAIZ=<repo> [-DMINIMO=<SATCFDI_MACOS_MINIMUM_VERSION>] -P verificar-manifiesto.cmake
#
# Sin Xcode: recalcula el SHA-256 de cada fuente y salida listada en
# resources/macos/AppIcon.manifiesto y falla si alguno no coincide (icono
# desactualizado: ejecutar tools/app-icon/regenerar_app_icon). Ademas exige
# que el manifiesto liste todos los archivos de AppIcon.icon y las cinco capas
# de resources/branding/icono, y que cada capa del .icon sea igual a la suya.
# `xcode`, `minimo-macos` y `comando` son obligatorios; el comando debe usar
# ese minimo y, con -DMINIMO, el minimo debe ser el del build que se prueba.
if(NOT RAIZ)
    message(FATAL_ERROR "verificar-manifiesto: falta -DRAIZ")
endif()

set(_manifiesto "${RAIZ}/resources/macos/AppIcon.manifiesto")
if(NOT EXISTS "${_manifiesto}")
    message(FATAL_ERROR "No existe ${_manifiesto}")
endif()

file(STRINGS "${_manifiesto}" _lineas)
set(_errores "")
set(_fuentes "")
set(_salidas "")
set(_xcode "")
set(_minimo "")
set(_comando "")
foreach(_linea IN LISTS _lineas)
    if(_linea MATCHES "^#" OR _linea STREQUAL "")
        continue()
    endif()
    if(_linea MATCHES "^xcode\t(.+)$")
        set(_xcode "${CMAKE_MATCH_1}")
    elseif(_linea MATCHES "^minimo-macos\t(.+)$")
        set(_minimo "${CMAKE_MATCH_1}")
    elseif(_linea MATCHES "^comando\t(.+)$")
        set(_comando "${CMAKE_MATCH_1}")
    elseif(_linea MATCHES "^(fuente|salida)\t([0-9a-f]+)\t(.+)$")
        set(_tipo "${CMAKE_MATCH_1}")
        set(_hash "${CMAKE_MATCH_2}")
        set(_rel "${CMAKE_MATCH_3}")
        if(_tipo STREQUAL "fuente")
            list(APPEND _fuentes "${_rel}")
        else()
            list(APPEND _salidas "${_rel}")
        endif()
        if(NOT EXISTS "${RAIZ}/${_rel}")
            list(APPEND _errores "falta ${_tipo} ${_rel}")
        else()
            file(SHA256 "${RAIZ}/${_rel}" _real)
            if(NOT _real STREQUAL _hash)
                list(APPEND _errores "${_tipo} distinta del manifiesto: ${_rel}")
            endif()
        endif()
    else()
        list(APPEND _errores "linea no reconocida: ${_linea}")
    endif()
endforeach()

if(_xcode STREQUAL "")
    list(APPEND _errores "el manifiesto no registra xcodebuild -version")
endif()
if(NOT _minimo MATCHES "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$")
    list(APPEND _errores "el manifiesto no registra minimo-macos valido")
elseif(MINIMO AND NOT _minimo STREQUAL MINIMO)
    list(APPEND _errores "icono compilado para macOS ${_minimo} y el build usa ${MINIMO} "
                         "(SATCFDI_MACOS_MINIMUM_VERSION)")
endif()
if(NOT _comando MATCHES "^xcrun actool resources/macos/AppIcon\\.icon .*--app-icon AppIcon")
    list(APPEND _errores "el manifiesto no registra el comando actool")
elseif(NOT _comando MATCHES "--minimum-deployment-target ${_minimo} ")
    list(APPEND _errores "el comando no usa el minimo-macos del manifiesto")
endif()
foreach(_s IN ITEMS Assets.car AppIcon.icns)
    if(NOT "resources/macos/AppIcon-compilado/${_s}" IN_LIST _salidas)
        list(APPEND _errores "el manifiesto no lista la salida ${_s}")
    endif()
endforeach()

# Todo archivo del .icon debe estar en el manifiesto.
file(GLOB_RECURSE _icon RELATIVE "${RAIZ}" "${RAIZ}/resources/macos/AppIcon.icon/*")
foreach(_rel IN LISTS _icon)
    if(_rel MATCHES "\\.DS_Store$")
        continue()
    endif()
    if(NOT _rel IN_LIST _fuentes)
        list(APPEND _errores "archivo del .icon fuera del manifiesto: ${_rel}")
    endif()
endforeach()

foreach(_capa IN ITEMS carpeta pestana hoja-posterior hoja-anterior frente)
    set(_marca "resources/branding/icono/icono-${_capa}.svg")
    set(_copia "resources/macos/AppIcon.icon/Assets/icono-${_capa}.svg")
    if(NOT _marca IN_LIST _fuentes OR NOT _copia IN_LIST _fuentes)
        list(APPEND _errores "el manifiesto no lista la capa ${_capa}")
    elseif(EXISTS "${RAIZ}/${_marca}" AND EXISTS "${RAIZ}/${_copia}")
        file(SHA256 "${RAIZ}/${_marca}" _h1)
        file(SHA256 "${RAIZ}/${_copia}" _h2)
        if(NOT _h1 STREQUAL _h2)
            list(APPEND _errores "la capa ${_capa} del .icon difiere de resources/branding/icono")
        endif()
    endif()
endforeach()

if(_errores)
    list(JOIN _errores "\n  " _texto)
    message(FATAL_ERROR "Icono compilado desactualizado o manifiesto invalido "
                        "(regenerar con tools/app-icon/regenerar_app_icon):\n  ${_texto}")
endif()
list(LENGTH _fuentes _nf)
message(STATUS "AppIcon: ${_nf} fuentes y 2 salidas coinciden con el manifiesto (${_xcode})")
